#!/usr/bin/env bash
# dotforge dot — unified CLI for diagnostics and configuration
#
# Usage:
#   dot                    # print help
#   dot help               # same as above
#   dot doctor [--check=<name>]  # run diagnostics
#   dot apply [OPTIONS]    # apply chezmoi dotfiles with delta
#   dot snapshot [OPTIONS] # capture machine state + git commit
#   dot pull [OPTIONS]     # sync from origin, apply, doctor
#   dot status [OPTIONS]   # non-destructive divergence report
#   dot features           # list feature flags with values and sources
#   dot setup [OPTIONS]    # bootstrap dotforge (= bootstrap.sh setup)
#   dot version            # print version and branch

set -euo pipefail

# ── Repo discovery (pattern B) ──
if ! command -v chezmoi >/dev/null 2>&1; then
    printf "dot: chezmoi is not on PATH — install it ('brew install chezmoi') or check PATH\n" >&2
    exit 1
fi
SOURCE_PATH="$(chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi")"
REPO_ROOT="${SOURCE_PATH%/chezmoi}"
if [[ ! -d "$REPO_ROOT" ]] || [[ ! -f "$REPO_ROOT/scripts/doctor.sh" ]]; then
    printf "dot: dotforge repo not found at '%s' (chezmoi source-path: '%s')\n" "$REPO_ROOT" "$SOURCE_PATH" >&2
    exit 1
fi

# ── Dispatcher ──
SUBCOMMAND="${1:-help}"

case "$SUBCOMMAND" in
    doctor)
        shift || true
        DOTFORGE_BRANCH="${DOTFORGE_BRANCH:-main}" exec bash "$REPO_ROOT/scripts/doctor.sh" "$@"
        ;;
    apply)
        shift || true
        exec bash "$REPO_ROOT/scripts/dot-apply.sh" "$@"
        ;;
    snapshot)
        shift || true
        exec bash "$REPO_ROOT/scripts/dot-snapshot.sh" "$@"
        ;;
    pull)
        shift || true
        exec bash "$REPO_ROOT/scripts/dot-pull.sh" "$@"
        ;;
    status)
        shift || true
        exec bash "$REPO_ROOT/scripts/dot-status.sh" "$@"
        ;;
    features)
        shift || true
        exec bash "$REPO_ROOT/scripts/dot-features.sh" "$@"
        ;;
    setup)
        shift || true
        exec bash "$REPO_ROOT/bootstrap.sh" setup "$@"
        ;;
    version)
        HASH="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
        BRANCH="$(git -C "$REPO_ROOT" branch --show-current 2>/dev/null || echo "detached")"
        printf "dotforge %s on %s\n" "$HASH" "$BRANCH"
        exit 0
        ;;
    help|-h|--help)
        cat << 'EOF'
dotforge dot — unified CLI for diagnostics and configuration

Usage:
  dot [SUBCOMMAND] [OPTIONS]

Subcommands:
  doctor [--check=<name>]       run read-only diagnostic checks
  apply [OPTIONS]               apply chezmoi dotfiles with before/after doctor delta
  snapshot [OPTIONS]            capture current machine state to canonical files + git commit
  pull [OPTIONS]                sync from origin: git pull --ff-only, chezmoi apply, doctor
  status [OPTIONS]              non-destructive divergence report (ahead/behind, dirty, scanner outputs, doctor)
  features                      list feature flags with current values and sources
  setup [OPTIONS]               bootstrap dotforge (alias for bootstrap.sh setup)
  version                        print version and branch
  help, -h, --help              show this help message

Options (doctor):
  --check=<name>                run a single named check
  --color, --no-color           force or disable ANSI colors

Named checks: chezmoi, brewfile, cli-globals, curl-toolchains,
              ssh-keys, macos-defaults, login-autostart, repo

Exit codes:
  0                             all checks passed
  1                             one or more warnings
  2                             one or more failures
EOF
        exit 0
        ;;
    *)
        printf "dot: unknown subcommand '%s' (run 'dot help')\n" "$SUBCOMMAND" >&2
        exit 1
        ;;
esac
