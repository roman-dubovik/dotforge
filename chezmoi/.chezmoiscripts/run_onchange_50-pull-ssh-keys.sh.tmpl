#!/usr/bin/env bash
# Pull SSH keys from Bitwarden for the active profile.
# version: ssh-keys-v2 {{ .profile }}

set -euo pipefail

PROFILE="{{ .profile }}"
SOURCE_PATH="$(chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi")"
REPO_ROOT="${SOURCE_PATH%/chezmoi}"

# shellcheck source=/dev/null
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=/dev/null
source "$REPO_ROOT/lib/secrets.sh"

# All keys live as attachments on a single Bitwarden item per profile.
ITEM="dotforge-ssh-$PROFILE"

# Key basenames per profile (private + .pub auto-derived).
{{ if eq .profile "personal" -}}
KEY_BASENAMES=(
    id_ed25519_github_booroman
    id_ed25519
    id_ed25519_ident_tg_bot
    id_rsa
    id_rsa_pureboard
)
{{ else if eq .profile "work" -}}
KEY_BASENAMES=(
    id_ed25519_work
)
{{- end }}

# Skip entirely if every key (and its .pub) is already present and non-empty.
all_present=true
for basename in "${KEY_BASENAMES[@]}"; do
    if [[ ! -s "$HOME/.ssh/$basename" || ! -s "$HOME/.ssh/$basename.pub" ]]; then
        all_present=false
        break
    fi
done
if $all_present; then
    log_ok "All SSH keys for profile '$PROFILE' already in place"
    exit 0
fi

log_info "Restoring SSH keys for profile '$PROFILE' from Bitwarden item '$ITEM'..."

bw_ensure_unlocked || {
    log_error "Cannot unlock Bitwarden — skipping SSH key restore."
    log_warn "Run 'chezmoi apply' again after 'bw unlock' to restore keys."
    exit 0
}

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

# Track files we create in this run so cleanup-on-error only removes our own
# partial writes (never the user's pre-existing keys).
declare -a CREATED_FILES=()
cleanup_partial() {
    # Guard against `set -u` on empty arrays (bash 5.x raises unbound).
    [[ ${#CREATED_FILES[@]} -eq 0 ]] && return
    for f in "${CREATED_FILES[@]}"; do
        rm -f "$f"
    done
}
trap cleanup_partial ERR

for basename in "${KEY_BASENAMES[@]}"; do
    KEY_PATH="$HOME/.ssh/$basename"
    PUB_PATH="$KEY_PATH.pub"

    if [[ -s "$KEY_PATH" && -s "$PUB_PATH" ]]; then
        log_ok "$basename already present"
        continue
    fi

    bw_get_attachment "$basename" "$ITEM" "$KEY_PATH" || {
        log_error "Failed to fetch private key '$basename' from Bitwarden item '$ITEM'"
        exit 1
    }
    CREATED_FILES+=("$KEY_PATH")

    bw_get_attachment "$basename.pub" "$ITEM" "$PUB_PATH" || {
        log_error "Failed to fetch public key '$basename.pub'"
        exit 1
    }
    CREATED_FILES+=("$PUB_PATH")

    chmod 600 "$KEY_PATH"
    chmod 644 "$PUB_PATH"
    log_ok "Restored: $basename"
done

trap - ERR
log_ok "SSH keys restored for profile '$PROFILE'"
