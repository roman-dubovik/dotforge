#!/usr/bin/env bash
# Pull SSH keys from Bitwarden for the active profile + machine.
#
# Two-tier item naming:
#   dotforge-ssh-<profile>            — keys shared across all machines of
#                                       this profile (e.g., the GitHub key
#                                       you copy to every personal Mac)
#   dotforge-ssh-<profile>-<machine>  — keys that live on this specific
#                                       machine only (e.g., a default
#                                       id_ed25519 with unique content per
#                                       Mac, or a one-off deploy key)
#
# The hook reads the attachment list from each item dynamically, so adding
# a key only requires uploading it to one of these items (see
# scripts/add-ssh-key.sh) — no source-code change to this hook.
#
# version: ssh-keys-v3 {{ .profile }} {{ .machine_name }}

set -euo pipefail

PROFILE="{{ .profile }}"
MACHINE_NAME="{{ .machine_name }}"
SOURCE_PATH="$(chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi")"
REPO_ROOT="${SOURCE_PATH%/chezmoi}"

# shellcheck source=/dev/null
source "$REPO_ROOT/lib/log.sh"
# shellcheck source=/dev/null
source "$REPO_ROOT/lib/secrets.sh"

ITEM_PROFILE="dotforge-ssh-$PROFILE"
ITEM_MACHINE="dotforge-ssh-$PROFILE-$MACHINE_NAME"

# List the basenames of private-key attachments inside a Bitwarden item.
# Returns nothing (and exit 0) if the item doesn't exist.
list_keys_in_item() {
    local item="$1"
    bw get item "$item" 2>/dev/null \
        | jq -r '.attachments[]?.fileName' 2>/dev/null \
        | grep -v '\.pub$' \
        || true
}

bw_ensure_unlocked || {
    log_error "Cannot unlock Bitwarden — skipping SSH key restore."
    log_warn "Run 'chezmoi apply' again after 'bw unlock' to restore keys."
    exit 0
}

# Build a list of (basename|source_item) tasks. Machine-level keys win on
# duplicate basename — they're processed first and their basename is added
# to the seen list so the profile-level loop skips it.
TASKS=()
SEEN=()

is_seen() {
    local target="$1" s
    for s in "${SEEN[@]:-}"; do
        [[ "$s" == "$target" ]] && return 0
    done
    return 1
}

while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if ! is_seen "$f"; then
        TASKS+=("$f|$ITEM_MACHINE")
        SEEN+=("$f")
    fi
done < <(list_keys_in_item "$ITEM_MACHINE")

while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if ! is_seen "$f"; then
        TASKS+=("$f|$ITEM_PROFILE")
        SEEN+=("$f")
    fi
done < <(list_keys_in_item "$ITEM_PROFILE")

if (( ${#TASKS[@]} == 0 )); then
    log_warn "No SSH keys found in '$ITEM_PROFILE' or '$ITEM_MACHINE'."
    log_warn "Run scripts/add-ssh-key.sh <basename> to upload a key first."
    exit 0
fi

# Skip entirely if every key is already on disk
all_present=true
for task in "${TASKS[@]}"; do
    basename="${task%|*}"
    if [[ ! -s "$HOME/.ssh/$basename" || ! -s "$HOME/.ssh/$basename.pub" ]]; then
        all_present=false
        break
    fi
done
if $all_present; then
    log_ok "All SSH keys for profile '$PROFILE' (machine $MACHINE_NAME) already in place"
    exit 0
fi

log_info "Restoring SSH keys for profile '$PROFILE' (machine $MACHINE_NAME)..."

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

declare -a CREATED_FILES=()
cleanup_partial() {
    [[ ${#CREATED_FILES[@]} -eq 0 ]] && return
    for f in "${CREATED_FILES[@]}"; do
        rm -f "$f"
    done
}
trap cleanup_partial ERR

for task in "${TASKS[@]}"; do
    basename="${task%|*}"
    item="${task#*|}"
    KEY_PATH="$HOME/.ssh/$basename"
    PUB_PATH="$KEY_PATH.pub"

    if [[ -s "$KEY_PATH" && -s "$PUB_PATH" ]]; then
        log_ok "$basename already present"
        continue
    fi

    bw_get_attachment "$basename" "$item" "$KEY_PATH" || {
        log_error "Failed to fetch private key '$basename' from '$item'"
        exit 1
    }
    CREATED_FILES+=("$KEY_PATH")

    bw_get_attachment "$basename.pub" "$item" "$PUB_PATH" || {
        log_error "Failed to fetch public key '$basename.pub' from '$item'"
        exit 1
    }
    CREATED_FILES+=("$PUB_PATH")

    chmod 600 "$KEY_PATH"
    chmod 644 "$PUB_PATH"
    log_ok "Restored: $basename (from $item)"
done

trap - ERR
log_ok "SSH keys restored for profile '$PROFILE' (machine $MACHINE_NAME): ${#TASKS[@]} key(s) total"
