#!/usr/bin/env bash
# Apply Brewfile. Re-runs when Brewfile content (hash) changes.
# Prefers Brewfile.local (produced by scripts/customize-brewfile.sh) over
# the canonical Brewfile when both exist, so users can run a customized
# subset without modifying the source-of-truth.
# version: brewfile-v4 {{ .profile }} features={{ if hasKey . "features" }}{{ .features | toJson | sha256sum | substr 0 8 }}{{ else }}none{{ end }}

set -euo pipefail

SOURCE_PATH="$(chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi")"
REPO_ROOT="${SOURCE_PATH%/chezmoi}"
BREWFILE_LOCAL="$REPO_ROOT/Brewfile.local"
BREWFILE_CANONICAL="$REPO_ROOT/Brewfile"

# Read archetype from chezmoi template data (empty string if key not present).
ARCHETYPE="{{ index . "brewfile_archetype" | default "" }}"

# Collect feature flags from chezmoi data (if present).
FEATURE_ARGS=()
{{- if hasKey . "features" }}
{{- $featuresHash := .features | toJson | sha256sum | substr 0 8 }}
{{- range $feature, $enabled := .features }}
{{- if $enabled }}
FEATURE_ARGS+=( "--enable={{ $feature }}" )
{{- else }}
FEATURE_ARGS+=( "--disable={{ $feature }}" )
{{- end }}
{{- end }}
EXPECTED_FEATURES_HASH="{{ $featuresHash }}"
{{- else }}
EXPECTED_FEATURES_HASH=""
{{- end }}

# Determine if Brewfile.local needs regeneration:
#   - File is absent, OR
#   - features hash in file differs from expected (features changed).
# Guard: only regen when archetype is known and not "custom" (custom = user-curated).
NEEDS_REGEN=0
STORED_HASH=""
if [[ -f "$BREWFILE_LOCAL" ]]; then
    STORED_HASH="$(grep -m1 '^# features-hash:' "$BREWFILE_LOCAL" 2>/dev/null | awk '{print $3}' || true)"
fi

if [[ -n "$ARCHETYPE" ]] && [[ "$ARCHETYPE" != "custom" ]]; then
    [[ ! -f "$BREWFILE_LOCAL" ]] && NEEDS_REGEN=1
    [[ -n "$EXPECTED_FEATURES_HASH" && "$STORED_HASH" != "$EXPECTED_FEATURES_HASH" ]] && NEEDS_REGEN=1
fi

if (( NEEDS_REGEN == 1 )); then
    echo "[brewfile-hook] Brewfile.local absent or features hash changed; regenerating from archetype '$ARCHETYPE'..."
    if ! bash "$REPO_ROOT/scripts/customize-brewfile.sh" --archetype "$ARCHETYPE" --non-interactive \
            ${FEATURE_ARGS[@]+"${FEATURE_ARGS[@]}"} --no-install --output "$BREWFILE_LOCAL.tmp"; then
        rm -f "$BREWFILE_LOCAL.tmp"
        if [[ -f "$BREWFILE_LOCAL" ]]; then
            echo "[brewfile-hook] ERROR: customize-brewfile.sh failed; existing Brewfile.local may be stale (features may differ)." >&2
            echo "[brewfile-hook] ERROR: Either fix the issue and re-apply, OR remove \"$BREWFILE_LOCAL\" to force canonical Brewfile usage." >&2
            exit 1
        else
            echo "[brewfile-hook] WARN: customize-brewfile.sh failed; falling back to canonical Brewfile (no Brewfile.local present)" >&2
        fi
    else
        # Prepend features-hash comment so future runs can detect feature drift.
        if [[ -n "$EXPECTED_FEATURES_HASH" ]]; then
            (printf "# features-hash: %s\n" "$EXPECTED_FEATURES_HASH"; cat "$BREWFILE_LOCAL.tmp") > "$BREWFILE_LOCAL"
            rm -f "$BREWFILE_LOCAL.tmp"
        else
            mv "$BREWFILE_LOCAL.tmp" "$BREWFILE_LOCAL"
        fi
    fi
fi

if [[ -f "$BREWFILE_LOCAL" ]]; then
    BREWFILE="$BREWFILE_LOCAL"
    echo "[brewfile-hook] Using customized Brewfile: $BREWFILE"
elif [[ -f "$BREWFILE_CANONICAL" ]]; then
    BREWFILE="$BREWFILE_CANONICAL"
    echo "[brewfile-hook] Using canonical Brewfile: $BREWFILE"
else
    echo "[brewfile-hook] No Brewfile found at $BREWFILE_CANONICAL" >&2
    exit 1
fi

brew bundle install --file="$BREWFILE" --no-lock
