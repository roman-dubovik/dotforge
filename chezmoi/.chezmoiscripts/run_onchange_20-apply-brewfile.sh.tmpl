#!/usr/bin/env bash
# Apply Brewfile. Re-runs when Brewfile content (hash) changes.
# Prefers Brewfile.local (produced by scripts/customize-brewfile.sh) over
# the canonical Brewfile when both exist, so users can run a customized
# subset without modifying the source-of-truth.
# version: brewfile-v4 {{ .profile }} features={{ .features | toJson | sha256sum | substr 0 8 }}

set -euo pipefail

SOURCE_PATH="$(chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi")"
REPO_ROOT="${SOURCE_PATH%/chezmoi}"
BREWFILE_LOCAL="$REPO_ROOT/Brewfile.local"
BREWFILE_CANONICAL="$REPO_ROOT/Brewfile"

# Read archetype from chezmoi template data (empty string if key not present).
ARCHETYPE="{{ index . "brewfile_archetype" | default "" }}"

# Collect feature flags from chezmoi data (if present).
FEATURE_ARGS=()
{{- if hasKey . "features" }}
{{- range $feature, $enabled := .features }}
{{- if $enabled }}
FEATURE_ARGS+=( "--enable={{ $feature }}" )
{{- else }}
FEATURE_ARGS+=( "--disable={{ $feature }}" )
{{- end }}
{{- end }}
{{- end }}

# Auto-generate Brewfile.local from archetype when missing and archetype is
# not "custom" (custom requires interactive selection) and not empty.
if [[ ! -f "$BREWFILE_LOCAL" ]] && [[ -n "$ARCHETYPE" ]] && [[ "$ARCHETYPE" != "custom" ]]; then
    echo "[brewfile-hook] Brewfile.local absent; generating from archetype '$ARCHETYPE'..."
    if ! bash "$REPO_ROOT/scripts/customize-brewfile.sh" --archetype "$ARCHETYPE" --non-interactive "${FEATURE_ARGS[@]}" --no-install; then
        rm -f "$BREWFILE_LOCAL"  # defensive: ensure no partial file confuses next-block guard
        echo "[brewfile-hook] WARN: customize-brewfile.sh failed; falling back to canonical Brewfile" >&2
    fi
fi

if [[ -f "$BREWFILE_LOCAL" ]]; then
    BREWFILE="$BREWFILE_LOCAL"
    echo "[brewfile-hook] Using customized Brewfile: $BREWFILE"
elif [[ -f "$BREWFILE_CANONICAL" ]]; then
    BREWFILE="$BREWFILE_CANONICAL"
    echo "[brewfile-hook] Using canonical Brewfile: $BREWFILE"
else
    echo "[brewfile-hook] No Brewfile found at $BREWFILE_CANONICAL" >&2
    exit 1
fi

brew bundle install --file="$BREWFILE" --no-lock
